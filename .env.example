# Local secrets for insight-service (gitignored — never commit real keys).
# Copy this file to .env at the repository root and fill in your keys.
# insight-service loads .env automatically at startup — no sourcing needed.
# Real environment variables override values from .env; set ENERGY_TRACKER_ENV_FILE
# to load a different file instead.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Upstash Redis (insight cache). REDIS_URL is used by the service; the REST
# pair is kept for admin/scripts. Without REDIS_URL the service falls back to
# redis://localhost:6379.
REDIS_URL=rediss://default:your-upstash-token@your-instance.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional overrides
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# INSIGHT_DEFAULT_PROVIDER=groq
# INSIGHT_DEFAULT_MODEL=openai/gpt-oss-120b
